# OpenAI Configuration (Optional for DEMO_MODE=true)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mode & Execution
DEMO_MODE=true
HEADLESS=true
MAX_PRODUCTS_PER_SITE=10
TOP_K=5
MAX_RETRIES=2
PAGE_TIMEOUT=30000
ACTION_TIMEOUT=10000

# Scoring Weights (Must sum to 1.0)
MATERIAL_WEIGHT=0.4
PRICE_WEIGHT=0.3
SHIPPING_WEIGHT=0.2
RATING_WEIGHT=0.1
